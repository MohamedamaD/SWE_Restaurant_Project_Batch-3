# Database Credentials
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=restaurant_db
DB_PORT=3306

# App Configurations
PORT=3000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d

# Stripe Payment Keys
STRIPE_SECRET_KEY=sk_test_...
